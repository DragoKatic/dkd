# Drago Katić Development: Apache configuration for the commercial hosting.
# Generated by build-htaccess.py from htaccess.template (in the archive, outside the site) - do not edit.
# The site must sit at the root of its domain (ErrorDocument and the redirects use root paths).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# 401/403 as plain text: with a file ErrorDocument only for 404, Apache reports a 401/403 loop on password-protected
# directories (stats/) and the browser may not show the login prompt
ErrorDocument 401 "Authorization required"
ErrorDocument 403 "Forbidden"
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/webp .webp
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType text/javascript .js
    AddType video/webm .webm
    AddType video/mp4 .mp4
    AddType application/acad .dwg
    AddCharset UTF-8 .html .css .js .json .webmanifest .xml .txt .svg
</IfModule>

# ---- Redirects ------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hidden files (.git, .htaccess, .env ...) are never served; .well-known stays for certificates
    RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

    # Download counts of download.php (data/dkd-downloads.sqlite) are never served
    RewriteRule ^data(/|$) - [R=404,L]

    # HTTPS (also behind a proxy that sets X-Forwarded-Proto)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # One address: without www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # /index.html -> / (only when asked for directly, not for the DirectoryIndex lookup)
    RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
    RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# ---- Compression ----------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml image/x-icon
</IfModule>
<IfModule !mod_brotli.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/ld+json application/manifest+json application/xml image/svg+xml image/x-icon
    </IfModule>
</IfModule>

# ---- Caching --------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Pages: always ask the server whether they changed (ETag / Last-Modified)
    <FilesMatch "\.(html|xml|txt|webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # CSS/JS: a day; the main site's bundles are linked with ?v=<hash> and can be kept a year
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
        <If "%{QUERY_STRING} =~ /^v=[0-9a-f]+$/">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>
    # The service worker is checked on every start, otherwise a new version is not noticed
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Fonts change only with a new subset build
    <FilesMatch "\.(woff2)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    # Pictures, video, icons and papers: a month
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|webm|pdf|dwg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # SVG (logos, icons) is regenerated often and has unversioned names: a day, then revalidate
    <FilesMatch "\.svg$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </FilesMatch>
</IfModule>

# ---- Not indexed: material of the installed app (app icons) ------------------------
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/app/#">
        Header set X-Robots-Tag "noindex, nofollow"
    </If>
</IfModule>

# ---- Image search: only a small, chosen set is indexed ------------------------------------
# Indexable: the logo, the portrait, the project screenshots and the photos/illustrations of the demo
# themes (largest size of each). Everything else that is a picture or a clip -- white logo, icons,
# marks, galaxy, social cards, small sizes, app icons -- gets noindex (the files still load normally).
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#\.(svg|png|jpe?g|webp|gif|ico|mp4|webm)$# && !(%{REQUEST_URI} =~ m#^/(images/(logo\.svg|logo-title-on-light\.svg|drago-katic\.jpg)|images/projects/[a-z]+\.webp|themes/[a-z]+/(photos|art|covers|illustrations|images/work)/[^/]+\.(webp|svg)|themes/brightcut/images/railway\.webp)$# && !(%{REQUEST_URI} =~ m#-(320|400|600|720|730)\.webp$#))">
        Header set X-Robots-Tag "noindex"
    </If>
</IfModule>

# ---- Never served: stray files (backups, archives, sources, logs, dumps) -------------------
<FilesMatch "\.(zip|bak|old|orig|swp|sql|sqlite|log|py|sh|md)$">
    Require all denied
</FilesMatch>

# ---- Security -------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    # PHP version is not announced (the host leaves expose_php On)
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # Trackers (Google Analytics 4, Microsoft Clarity, Meta Pixel) are loaded by js/core.js after
    # consent (GA4 hosts as recommended by Google; its audience pixel goes to google.<country>, only
    # google.rs is listed). Inline scripts are allowed by their hashes.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-2waZBAc/CW/8TekG2BH6eG7uo9t0HCrBLq59i9lYVSk=' 'sha256-2yLWD5FDGNPL2mAaHEVHa6DlVCRX1L+3p5HxUhm5DMc=' 'sha256-riitXBKGtl5y5ccA7GF6ccqJuwEVP5tm8j0ff/fbw9U=' 'sha256-xY9EYvPK1YuUZ3BVzzltTfKIkQs+ky3O4O+rQHw+g5s=' https://www.googletagmanager.com https://*.clarity.ms https://connect.facebook.net https://snap.licdn.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://www.google.rs https://*.clarity.ms https://c.bing.com https://www.facebook.com https://*.ads.linkedin.com https://www.linkedin.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://*.google.com https://*.clarity.ms https://c.bing.com https://www.facebook.com https://connect.facebook.net https://*.ads.linkedin.com https://www.linkedin.com; media-src 'self'; worker-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
